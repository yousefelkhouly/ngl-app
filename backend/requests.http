@base = http://localhost:5000/api
@email = you@example.com

### health (not under /api)
GET http://localhost:5000/health

### ---------- account ----------

### register (emails a verification code)
POST {{base}}/auth/register
Content-Type: application/json

{
  "name": "med",
  "email": "{{email}}",
  "password": "123456"
}

### verify account with the code from register or /send-otp (also logs you in)
PATCH {{base}}/auth/verify-account
Content-Type: application/json

{ "email": "{{email}}", "code": "123456" }

### send a new account code (for verify-account or reset-password)
POST {{base}}/auth/send-otp
Content-Type: application/json

{ "email": "{{email}}" }

### reset password with the code from /send-otp
PATCH {{base}}/auth/reset-password
Content-Type: application/json

{ "email": "{{email}}", "code": "123456", "newPassword": "1234567" }

### ---------- login ----------

### login (2FA off: logs you in. 2FA on: emails a login code instead)
POST {{base}}/auth/login
Content-Type: application/json

{ "email": "{{email}}", "password": "123456" }

### 2FA on: log in with the login code
POST {{base}}/auth/verify-code-to-login
Content-Type: application/json

{ "email": "{{email}}", "code": "123456" }

### signed in: email a code to turn 2FA on (or off, with "enabled": false)
POST {{base}}/auth/two-step/code
Content-Type: application/json

{ "enabled": true }

### signed in: confirm with that code
PATCH {{base}}/auth/two-step
Content-Type: application/json

{ "enabled": true, "code": "123456" }

### ---------- account settings (logged in) ----------

### change password (signs out other devices). Google accounts without one leave out currentPassword
PATCH {{base}}/auth/password
Content-Type: application/json

{ "currentPassword": "123456", "newPassword": "1234567" }

### change email: a code goes to the new address
POST {{base}}/auth/email/code
Content-Type: application/json

{ "email": "new@example.com" }

### ...then confirm with it
PATCH {{base}}/auth/email
Content-Type: application/json

{ "code": "123456" }

### delete the account (password required if it has one)
DELETE {{base}}/auth/account
Content-Type: application/json

{ "password": "123456" }

### new tokens from the refresh cookie
POST {{base}}/auth/refresh

### logout
POST {{base}}/auth/logout

### ---------- messages ----------

### message without an account (can never be accepted)
POST {{base}}/message
Content-Type: application/json

{ "content": "hello there", "receiver": "<user id>" }

### message while logged in: still anonymous to the receiver until they accept it
POST {{base}}/message/public
Content-Type: application/json

{ "content": "hello there", "receiver": "<user id>" }

### your inbox (logged in). each message has request: { _id, status } or null,
### and sender stays null until you accept its request
GET {{base}}/message/public

### delete a note from your inbox
DELETE {{base}}/message/<message id>

### block whoever sent a note (only notes sent while logged in); hides all their notes
POST {{base}}/message/<message id>/block

### report a note: harassment, hate, threat, spam or other. also removes it from your inbox
POST {{base}}/message/<message id>/report
Content-Type: application/json

{ "reason": "harassment" }

### ---------- requests (logged in, as the receiver) ----------

### accept: reveals the sender and opens a conversation
PATCH {{base}}/request/<request id>/accept

### decline: the sender stays hidden
PATCH {{base}}/request/<request id>/decline

### ---------- conversations (logged in) ----------

### your conversations, each with its last message
GET {{base}}/conversation

### one conversation with all its messages
GET {{base}}/conversation/<conversation id>

### send a message in a conversation
POST {{base}}/conversation/<conversation id>/messages
Content-Type: application/json

{ "content": "ok" }

### block the other person: they can't message you, and the chat leaves your list
POST {{base}}/conversation/<conversation id>/block

### ---------- profile ----------

### your profile: picture, cover images, documents, 2FA setting, how many you blocked (logged in)
GET {{base}}/user/me

### unblock everyone you blocked
DELETE {{base}}/user/blocked

### someone's public profile: name, username, picture and cover images only.
### by username (share links) or by account id (older links)
GET {{base}}/user/<username or user id>

### change your name and/or username
PATCH {{base}}/user/me
Content-Type: application/json

{ "name": "maya", "username": "maya.k" }

### remove your profile picture / cover images
DELETE {{base}}/user/profile-picture

###
DELETE {{base}}/user/cover-images

### uploads (logged in) are multipart; easiest from the app or with curl:
### curl -b cookies.txt -F "documents=@notes.pdf" {{base}}/user/documents

### delete one of your documents
DELETE {{base}}/user/documents/<document id>
