# copy to backend/.env and fill in. hosted values: see DEPLOY.md

PORT=5000
NODE_ENV=development
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>/<database>
# long random strings, different from each other
JWT_SECRET=
JWT_REFRESH_SECRET=
# the frontend's address(es), comma-separated
CLIENT_URL=http://localhost:3000

# Redis: a local one...
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# ...or a hosted one (Upstash): rediss://default:<password>@<host>:6379
REDIS_URL=

# email over SMTP (defaults are Gmail's; MAIL_PASS is a Gmail app password)
MAIL_USER=you@gmail.com
MAIL_PASS=
MAIL_FROM_NAME=unsaid
# or through Brevo's API (hosted): MAIL_USER is then a sender verified in Brevo
BREVO_API_KEY=

# uploads: empty keeps them in backend/uploads; set to store them on Cloudinary
CLOUDINARY_URL=

# optional: Google sign-in (same client id as the frontend's)
GOOGLE_CLIENT_ID=

# hosted: the same long random value as the frontend's PROXY_SECRET
PROXY_SECRET=
# number of proxies in front of the backend, when PROXY_SECRET isn't used
TRUST_PROXY=0
