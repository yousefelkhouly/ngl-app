# where the Express backend runs. server-only: the browser never sees it,
# it calls /api on this site and Next.js forwards the request
BACKEND_URL=http://localhost:5000

# public URL of this site, used for absolute links in metadata (optional in development)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google sign-in. leave empty to hide the Google button.
# must be the same client id as the backend's GOOGLE_CLIENT_ID
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# hosted only (e.g. Vercel): the same value as the backend's PROXY_SECRET, so the backend can
# rate-limit each visitor on their own. leave empty locally
PROXY_SECRET=
